{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joan-archive/research-control/correction-event.schema.json",
  "title": "Joan Archive Append-Only Correction Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correction_id",
    "timestamp",
    "correction_type",
    "target_refs",
    "reason",
    "disposition",
    "provenance"
  ],
  "properties": {
    "correction_id": {
      "type": "string",
      "pattern": "^CORR-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correction_type": {
      "type": "string",
      "enum": [
        "TRANSCRIPTION_CORRECTION",
        "SOURCE_CORRECTION",
        "INTERPRETATION_REVISION",
        "STATUS_REVISION",
        "IDENTITY_REOPENED",
        "UNSUPPORTED_INFERENCE_WITHDRAWN",
        "METHODOLOGY_CORRECTION"
      ]
    },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prior_record_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prior_wording": {
      "type": "string"
    },
    "corrected_wording": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "law_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "RETAINED",
        "NARROWED",
        "SUPERSEDED",
        "WITHDRAWN",
        "REOPENED",
        "UNRESOLVED"
      ]
    },
    "uncertainty": {
      "type": "string"
    },
    "next_test": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor",
        "platform",
        "recorded_at"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "HUMAN",
            "AI",
            "SYSTEM"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
